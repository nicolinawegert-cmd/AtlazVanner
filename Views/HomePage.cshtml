
@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage
@using Umbraco.Cms.Core.Models
@using Umbraco.Cms.Web.Common.PublishedModels
@using Umbraco.Extensions
@using System.Globalization

@{
    Layout = "master.cshtml";

    var heroTitle = Model.Value<string>("heroTitle");
    var heroText = Model.Value<string>("heroText");
    var heroImage = Model.Value<MediaWithCrops>("heroImage");
    var heroImageAlt = Model.Value<string>("heroImageAlt");
    var buttonText = Model.Value<string>("heroButtonText");

    var introTitle = Model.Value<string>("introTitle");
    var introText = Model.Value<string>("introText");

    var featuredPages = 
        Model.Value<IEnumerable<IPublishedContent>>("featuredPages")
        ?? Enumerable.Empty<IPublishedContent>();

    var cardImageDefaults = new Dictionary<Guid, (string Url, string Alt)>
    {
        [Guid.Parse("392331f2-3fa9-4eaf-903d-99519dfa25d4")] =
            ("/images/cards/prylar-leksaker.png", "Schäferhund med leksaker"),
        [Guid.Parse("469fb175-c5fa-48fb-82cd-beb4f63ec593")] =
            ("/images/cards/utflykter.jpeg", "Hundpromenad på en träspång i grönskande natur"),
        [Guid.Parse("f6a6adeb-b464-489f-bcbf-da88ed1df2ca")] =
            ("/images/cards/nyheter.jpeg", "Valp på gräsmatta")
    };

    var siteRoot = Model.Root();
    var newsPage = siteRoot?.ChildrenOfType("newsPage").FirstOrDefault();
    var memberPage = siteRoot?.ChildrenOfType("bliMedlemPage").FirstOrDefault();
    var latestNews = newsPage?.ChildrenOfType("newsItem")
        .OrderByDescending(item => item.Value<DateTime>("publishDate") is var date && date != default ? date : item.CreateDate)
        .Take(3)
        .ToList()
        ?? Enumerable.Empty<IPublishedContent>();

    var swedish = new CultureInfo("sv-SE");
    
}

<section class="hero">
    <div class="container hero-inner">

        <div class="hero-content">
            <span class="eyebrow">ATLAZ VÄNNER</span>

            <h1>@heroTitle</h1>

            <p>@heroText</p>

            <a class="btn-primary" href="#upptack">
                @(string.IsNullOrWhiteSpace(buttonText)
                    ? "Upptäck mer"
                    : buttonText)
            </a>
        </div>

        @if (heroImage != null)
        {
            <div class="hero-image">
                <img src="@heroImage.MediaUrl()"
                     alt="@heroImageAlt" />
            </div>
        }

    </div>
</section>

<section class="home-values" aria-label="Det här är Atlaz Vänner">
    <div class="container home-values__inner">
        <span>Gemenskap</span>
        <span>Utflykter</span>
        <span>Hundglädje</span>
    </div>
</section>

<section class="discover" id="upptack">
    <div class="container">

        <h2>Upptäck Atlaz Vänner</h2>

        <div class="discover__grid">

            @foreach (var item in featuredPages.Take(3))
            {
                var image = item.GetProperty("cardImage") != null
                    ? item.Value<MediaWithCrops>("cardImage")
                    : null;

                var description = item.GetProperty("cardDescription") != null
                    ? item.Value<string>("cardDescription")
                    : null;

                var fallbackImage = cardImageDefaults.GetValueOrDefault(item.Key);
                var imageUrl = image?.MediaUrl() ?? fallbackImage.Url;
                var imageAlt = image != null ? item.Name : fallbackImage.Alt;

                <a href="@(item.Url())" class="discover__card">

                    <div class="discover__image-wrapper">
                        @if (!string.IsNullOrWhiteSpace(imageUrl))
                        {
                            <img
                                src="@imageUrl"
                                alt="@imageAlt"
                                class="discover__image"
                                loading="lazy" />
                        }
                        else
                        {
                            <div class="discover__placeholder"
                                 aria-hidden="true">
                                🐾
                            </div>
                        }
                    </div>

                    <div class="discover__content">
                        <h3>@item.Name</h3>

                        @if (!string.IsNullOrWhiteSpace(description))
                        {
                            <p>@description</p>
                        }

                        <span class="discover__link">
                            Upptäck mer →
                        </span>
                    </div>

                </a>
            }

        </div>

    </div>
</section>

<section class="home-activity">
    <div class="container">
        <div class="home-activity__card">
            <div class="home-activity__date" aria-label="14 november 2026">
                <span>14</span>
                <small>nov</small>
            </div>
            <div class="home-activity__content">
                <p class="home-section-heading__eyebrow">Nästa aktivitet</p>
                <h2>Gemensam höstpromenad</h2>
                <p>Följ med Atlaz Vänner på en lugn promenad i naturen, med tid för både hundsnack och fika.</p>
                <p class="home-activity__place">Skrylle · Samling 10.00</p>
            </div>
            <a class="btn-primary" href="/nyheter/">Läs mer</a>
        </div>
    </div>
</section>

@if (latestNews.Any() && newsPage != null)
{
    <section class="home-news">
        <div class="container">
            <div class="home-section-heading">
                <div>
                    <p class="home-section-heading__eyebrow">Senaste från Atlaz</p>
                    <h2>Nytt i föreningen</h2>
                </div>
                <a href="@newsPage.Url()">Alla nyheter →</a>
            </div>

            <div class="home-news__grid">
                @foreach (var news in latestNews)
                {
                    var summary = news.Value<string>("summary");
                    var publishDate = news.Value<DateTime>("publishDate") is var date && date != default ? date : news.CreateDate;

                    <article class="home-news__item">
                        <time datetime="@publishDate.ToString("yyyy-MM-dd")">
                            @publishDate.ToString("d MMMM yyyy", swedish)
                        </time>
                        <h3><a href="@news.Url()">@news.Name</a></h3>
                        @if (!string.IsNullOrWhiteSpace(summary))
                        {
                            <p>@summary</p>
                        }
                        <a class="home-news__link" href="@news.Url()">Läs mer <span aria-hidden="true">→</span></a>
                    </article>
                }
            </div>
        </div>
    </section>
}

<section class="introduction">
    <div class="container">
        <h2>@introTitle</h2>
        <p>@introText</p>
    </div>
</section>

@if (memberPage != null)
{
    <section class="home-member">
        <div class="container home-member__inner">
            <div>
                <p class="home-member__eyebrow">Bli en del av flocken</p>
                <h2>Följ med på nästa äventyr</h2>
                <p>Hos Atlaz Vänner finns plats för hundar, människor och alla små stunder däremellan.</p>
            </div>
            <a class="btn-primary" href="@memberPage.Url()">Bli medlem</a>
        </div>
    </section>
}
