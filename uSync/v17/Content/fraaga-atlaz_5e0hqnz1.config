  <Properties>
    <atlazFacts>
      <Value><![CDATA[Atlaz är ordförande i hundföreningen Atlaz Vänner och expert på det mesta.
I föreningens galleri finns bilder på Atlaz i badet, i badrock och när han borstar tänderna.]]></Value>
    </atlazFacts>
    <cardDescription>
      <Value><![CDATA[Här hittar du tips, frågor och svar om livet med hund.]]></Value>
    </cardDescription>
    <cardImage>
      <Value><![CDATA[[
  {
    "key": "e5220491-4ef5-4dc6-8e75-2cbe5477f722",
